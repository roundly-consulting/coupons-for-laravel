includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
        - database
        - config
        # The HasCoupons trait is consumer-facing; the fixture that applies it is
        # analysed so PHPStan sees a real usage instead of flagging it unused.
        - tests/Fixtures
    # This package ships its own config/ dir; env() is correct there.
    configDirectories:
        - config
