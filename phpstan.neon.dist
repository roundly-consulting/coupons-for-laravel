includes:
    - vendor/larastan/larastan/extension.neon
    # The toolkit's Blueprint macro stubs (morphKey / ownerKey / polymorphicSubject) so
    # the key-type-aware migration columns resolve at level 7.
    - vendor/roundly-consulting/package-toolkit-for-laravel/extension.neon

parameters:
    level: 7
    paths:
        - src
        - database
        - config
        # The HasCoupons trait is consumer-facing; the fixture that applies it is
        # analysed so PHPStan sees a real usage instead of flagging it unused.
        - tests/Fixtures
    # This package ships its own config/ dir; env() is correct there.
    configDirectories:
        - config
